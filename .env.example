# App URL (used for API base URL). For build-time fetch (prerender / generateStaticParams),
# set this to your deployed URL so the build can reach your API (e.g. https://phonghub.cloud).
NEXT_PUBLIC_APP_URL=https://phonghub.cloud

# Google Analytics
NEXT_PUBLIC_GOOGLE_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_VERIFICATION=
# Resume Link
NEXT_PUBLIC_RESUME_LINK=your_resume_link
