# App URL (used for API base URL). For build-time fetch (prerender / generateStaticParams),
# set this to your deployed URL so the build can reach your API (e.g. https://phonghub.cloud).
NEXT_PUBLIC_APP_URL=https://phonghub.cloud

# Google Analytics
NEXT_PUBLIC_GOOGLE_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_VERIFICATION=
# Resume Link
NEXT_PUBLIC_RESUME_LINK=your_resume_link

# ─────────────────────────────────────────────────────────────────
# Server-only secrets below. Anything NOT prefixed NEXT_PUBLIC_ is
# never sent to the browser — only read in server components, route
# handlers, and lib/llm (which is guarded by the `server-only`
# package, so an accidental client import fails the build). These
# are the repo's first server secrets; keep them out of NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────────

# LLM gateway (lib/llm) — set a key only for providers you actually use.
# Set a spend cap in each configured provider's own console — see
# lib/llm/README.md.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# Model routing (alias = provider:model). Optional — defaults live in
# lib/llm/config.ts (chat = anthropic:claude-haiku-4-5, cheap = groq:llama-3.1-8b-instant).
LLM_CHAT_MODEL=
LLM_CHEAP_MODEL=
# Comma-separated provider:model fallback chain for the "chat" alias.
# Off by default (see implementation-notes.md, Deviations).
LLM_CHAT_FALLBACKS=

# Chat rate limiting (lib/chat/rate-limit.ts). If unset: requests are
# rejected in production, allowed through (with a console warning) in
# development — see implementation-notes.md, Deviations #3.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# GitHub "Star on GitHub" action (lib/github/client.ts, app/api/github/star).
# A fine-grained Personal Access Token scoped ONLY to the `starring` write
# permission (classic tokens: use the `public_repo` scope instead) on the
# GitHub account that should perform the star. Never exposed to the
# browser — read only in the server route handler.
GITHUB_TOKEN=
